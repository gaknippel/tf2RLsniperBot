# Ignore everything by default
*
!/.gitignore

!/python/
!/python/**

# toy_env training output -- regenerated by train.py/export_policy.py, not source
/python/toy_env/__pycache__/
/python/toy_env/tb_logs/
/python/toy_env/snapshots/
/python/toy_env/models/

# RL bridge: hand-picked files only within the (otherwise untracked) SDK
# source tree -- vendor/engine source stays untracked, only files we
# actually authored or edited for the RL bridge are project content. Open up
# just the directory chain down to them (git won't apply "!" file patterns
# inside a directory that's itself still ignored), then re-ignore everything
# at the final directory level before whitelisting specific files. Add a new
# "!" file line here each time this feature touches another existing SDK file.
!/src/
/src/*
!/src/game/
/src/game/*
!/src/game/server/
/src/game/server/*
!/src/game/server/tf/
/src/game/server/tf/*
!/src/game/server/tf/tf_sniper_policy.h
!/src/game/server/tf/tf_sniper_policy.cpp
!/src/game/server/tf/tf_sniper_policy_weights.h
!/src/game/server/tf/tf_sniper_bot.h
!/src/game/server/tf/tf_sniper_bot.cpp
!/src/game/server/tf/tf_player.h
!/src/game/server/tf/tf_client.cpp
!/src/game/server/server_tf.vpc

!/game/
/game/*
!/game/mod_tf/

/game/mod_tf/*

!/game/mod_tf/cfg/
!/game/mod_tf/cfg/**
!/game/mod_tf/maps/
!/game/mod_tf/maps/**
!/game/mod_tf/mapsrc/
!/game/mod_tf/mapsrc/**
!/game/mod_tf/scripts/
!/game/mod_tf/scripts/**
!/game/mod_tf/gameinfo.txt

# Now re-exclude the junk within those folders
/game/mod_tf/maps/*.bsp
/game/mod_tf/maps/*.log
/game/mod_tf/maps/*.prt
/game/mod_tf/maps/*.lin
/game/mod_tf/maps/graphs/**

/game/mod_tf/mapsrc/*.vmx
/game/mod_tf/mapsrc/*_autosave.vmf
/game/mod_tf/mapsrc/*.bsp
/game/mod_tf/mapsrc/*.log
/game/mod_tf/mapsrc/*.prt
/game/mod_tf/mapsrc/*.lin

/game/mod_tf/cfg/local_loadout.txt
/game/mod_tf/cfg/server_blacklist.txt
/game/mod_tf/cfg/settings.scr
/game/mod_tf/cfg/*.cfg.bak

/game/mod_tf/demos/